      "frameId": null,
      "index": "bl8V",
      "roundness": null,
      "seed": 1123232522,
      "version": 853,
      "versionNonce": 1400789898,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1760916748738,
      "link": null,
      "locked": false,
      "text": "By default, there is a SIGNIFICANT amount of \"padding\" (margin)\nthat prevents containers from getting smaller than text. You must\nhold \"Shift\" to resize the container AND the text simultaneously...\n\nBut even this doesn't solve all weirdness when working with very\nsmall objects. You'll notice that, in such cases, as the container gets\nsmaller and smaller, text will start to wrap onto new lines even\nthough there is clearly enough space for the text. \n\nThis can be frustrating when working with small custom graphics, like\nthe keyboard keys you'll see across this tutorial canvas. \n\nRefer to the next row for the solution to this.",
      "fontSize": 4.994707784152294,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "z1JcWDlXQNoFT447aUla6",
      "originalText": "By default, there is a SIGNIFICANT amount of \"padding\" (margin) that prevents containers from getting smaller than text. You must hold \"Shift\" to resize the container AND the text simultaneously...\n\nBut even this doesn't solve all weirdness when working with very small objects. You'll notice that, in such cases, as the container gets smaller and smaller, text will start to wrap onto new lines even though there is clearly enough space for the text. \n\nThis can be frustrating when working with small custom graphics, like the keyboard keys you'll see across this tutorial canvas. \n\nRefer to the next row for the solution to this.",
      "autoResize": true,
      "lineHeight": 1.25
    },
