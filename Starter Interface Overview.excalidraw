      "isDeleted": false,
      "boundElements": [],
      "updated": 1760965817787,
      "link": null,
      "locked": false,
      "text": "Here you control the\n*sloppiness* of the arrow\nstroke.\n1 = Architect = Clean\n2 = Artist = Medium\n3 = Cartoonist = Messy",
      "fontSize": 2.7535405190981392,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "aEVCeS5J8teVCgqFQbfnd",
      "originalText": "Here you control the *sloppiness* of the arrow stroke.\n1 = Architect = Clean\n2 = Artist = Medium\n3 = Cartoonist = Messy",
      "autoResize": true,
      "lineHeight": 1.25
    },
