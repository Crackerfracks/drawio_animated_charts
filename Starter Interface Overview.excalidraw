      "version": 432,
      "versionNonce": 1671416964,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1760936529457,
      "link": null,
      "locked": false,
      "text": "1. Holding       + hitting an arrow key\nwhen a shape is selected will:\n    - Copy the shape\n    - Paste that copy a set distance\naway\n    - Attach an arrow from the first\nshape to the second shape\n    - Will not finalize any of this until\nyou release `Ctrl`\n    - If you continue tapping the same\narrow key, additional copies of the\nshape will be created, all neatly\nconnected to the one you selected. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "3mmTv_DNtZmZqv2wiZzRb",
      "originalText": "1. Holding       + hitting an arrow key when a shape is selected will:\n    - Copy the shape\n    - Paste that copy a set distance away\n    - Attach an arrow from the first shape to the second shape\n    - Will not finalize any of this until you release `Ctrl`\n    - If you continue tapping the same arrow key, additional copies of the shape will be created, all neatly connected to the one you selected. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
