      "isDeleted": false,
      "boundElements": [],
      "updated": 1760965817787,
      "link": null,
      "locked": false,
      "text": "Here you control\nthe type of line\nused to form the\narrow.\n1 = Solid\n2 = Dashed\n3 = Dotted",
      "fontSize": 2.7535405190981392,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "ulHNf1QKorddrjdKNAdLd",
      "originalText": "Here you control the type of line used to form the arrow.\n1 = Solid\n2 = Dashed\n3 = Dotted",
      "autoResize": true,
      "lineHeight": 1.25
    },
