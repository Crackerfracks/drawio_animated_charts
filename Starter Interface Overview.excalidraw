    {
      "id": "a5sVqB6E_-FXm6LzssSdM",
      "type": "text",
      "x": 7605.7737594664995,
      "y": -8530.356113250631,
      "width": 39.43656921386719,
      "height": 30.97733083985407,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#ffec99",
      "fillStyle": "cross-hatch",
