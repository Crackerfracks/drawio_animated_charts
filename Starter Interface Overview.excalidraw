      "versionNonce": 1784047748,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1760965817787,
      "link": null,
      "locked": false,
      "text": "Here you choose the behavior\nand class of arrow. \n1 = Straight with one\nbendable joint per \"point\".\nAdjustable handle near\narrowhead\n\n2 = Curved arrow with one\nadjustable curve per \"point\"",
      "fontSize": 2.7535405190981392,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "sRn_o59E2CaCfVPfVzX3L",
      "originalText": "Here you choose the behavior and class of arrow. \n1 = Straight with one bendable joint per \"point\". Adjustable handle near arrowhead\n\n2 = Curved arrow with one adjustable curve per \"point\"",
      "autoResize": true,
      "lineHeight": 1.25
    },
