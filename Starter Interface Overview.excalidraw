      "updated": 1760965817787,
      "link": null,
      "locked": false,
      "text": "Here you control the\n*sloppiness* of the line.\n1 = Architect = Clean\n2 = Artist = Medium\n3 = Cartoonist = Messy",
      "fontSize": 2.7535405190981392,
      "fontFamily": 5,
      "textAlign": "center",
