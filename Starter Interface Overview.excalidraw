    {
      "id": "wJG1kb3572A4Tm37NqqSO",
      "type": "text",
      "x": 1549.7510822820057,
      "y": -9624.235789801794,
      "width": 120.61503601074219,
      "height": 97.53194760358824,
      "angle": 0,
      "strokeColor": "#6741d9",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 20,
      "groupIds": [],
      "frameId": null,
      "index": "bl5G",
      "roundness": null,
      "seed": 2132259414,
      "version": 1105,
      "versionNonce": 1311461014,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1760916386490,
      "link": null,
      "locked": false,
      "text": "Until now, you've (likely) only been working with text\nWITHIN containers; styling container & text alike,\ndealing with the restrictive 4 text size presets (S, M,\nL, XL).\n\nHowever, by right-clicking a text container and\nselecting \"Unbind text\", you can then work that text\nseparately from the container. \n\nIt's not quite as convenient to format outside a\ncontainer, but text unbound from a container retains\nwhatever position, size and formatting it had at the\nmoment it was unbound. \n\nSo if you're having trouble squeezing something into a\ntight fitting area, use this trick to save yourself a\nboatload of frustration and time!!",
      "fontSize": 4.589738710757094,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "PXl38uzQgPpg5Z_NMzLq2",
      "originalText": "Until now, you've (likely) only been working with text WITHIN containers; styling container & text alike, dealing with the restrictive 4 text size presets (S, M, L, XL).\n\nHowever, by right-clicking a text container and selecting \"Unbind text\", you can then work that text separately from the container. \n\nIt's not quite as convenient to format outside a container, but text unbound from a container retains whatever position, size and formatting it had at the moment it was unbound. \n\nSo if you're having trouble squeezing something into a tight fitting area, use this trick to save yourself a boatload of frustration and time!!",
      "autoResize": true,
      "lineHeight": 1.25
    },
